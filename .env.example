# Supabase (values come from `npx supabase start` for local development)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# "true" shows the two-button development login. "false" uses Google OAuth
# through Supabase Auth (see README for the Google Cloud setup).
NEXT_PUBLIC_DEV_AUTH=true

# Bearer token for POST /api/events
INGEST_TOKEN=change-me-to-a-long-random-string
